      "vintage-needle": "#ef2b2b",
      "vintage-needle-glow": "color-mix(in srgb, var(--vintage-needle) 50%, transparent)",
      "vintage-accent": "var(--vintage-light)",
      "vintage-accent-deep": "color-mix(in oklab, var(--vintage-light) 82%, var(--foreground))",
      "vintage-accent-glow": "color-mix(in srgb, var(--vintage-light) 60%, transparent)",
      "vintage-label": "var(--foreground)",
      "vintage-value": "var(--foreground)",
      "vintage-tube": "#0c0e0b",
      "vintage-tube-hi": "#1e201d",
      "vintage-face-ink": "#2a2014",
      "vintage-light": "var(--brand, #ffd700)",
      "vintage-brushed": "conic-gradient(from 90deg, #969aa0 0deg, #5d636c 9deg, #555b69 22deg, #dfdfdf 41deg, #71798a 63deg, #a9abb3 83deg, #cbd2d6 120deg, #ffffff 149deg, #5e646a 186deg, #8e959d 219deg, #ffffff 245deg, #7e8691 269deg, #575d6b 284deg, #6c747f 301deg, #f1f1f3 337deg, #979aa3 349deg, #b1b3b9 356deg, #969aa0 360deg)",
      "vintage-surface-1": "color-mix(in oklab, var(--background) 55%, black)",
      "vintage-surface-2": "var(--background)",
      "vintage-surface-3": "color-mix(in oklab, var(--foreground) 8%, var(--background))",
