      "vintage-grid": "color-mix(in oklab, var(--foreground) 70%, var(--background))",
      "vintage-cap-hi": "color-mix(in oklab, var(--foreground) 2%, var(--background))",
      "vintage-cap-lo": "color-mix(in oklab, var(--foreground) 20%, var(--background))",
      "vintage-base-hi": "color-mix(in oklab, var(--foreground) 12%, var(--background))",
      "vintage-base-lo": "color-mix(in oklab, var(--foreground) 36%, var(--background))",
      "vintage-depth-edge": "color-mix(in oklab, var(--foreground) 38%, var(--background))",
      "vintage-depth-mid": "color-mix(in oklab, var(--foreground) 20%, var(--background))",
      "vintage-depth-core": "color-mix(in oklab, var(--foreground) 8%, var(--background))",
      "vintage-ring-hi": "var(--background)",
      "vintage-ring-lo": "color-mix(in oklab, var(--foreground) 40%, var(--background))",
      "vintage-face-hi": "color-mix(in oklab, var(--vintage-light) 12%, #fdf6e0)",
      "vintage-face-mid": "color-mix(in oklab, var(--vintage-light) 14%, #f3e3b4)",
      "vintage-face-lo": "color-mix(in oklab, var(--vintage-light) 16%, #d9b970)",
      "vintage-panel-shadow": "inset 0 1px 0 rgb(255 255 255 / 0.7), 0 1px 1px rgb(0 0 0 / 0.12), 0 10px 24px -8px rgb(0 0 0 / 0.2)",
      "vintage-well-shadow": "inset 0 2px 5px rgb(0 0 0 / 0.22), inset 0 0 0 1px rgb(0 0 0 / 0.14), 0 1px 0 rgb(255 255 255 / 0.7)",
      "vintage-engrave": "0 1px 0 rgb(255 255 255 / 0.7)",
      "vintage-edge": "rgb(0 0 0 / 0.2)",
      "vintage-lip": "rgb(255 255 255 / 0.7)",
      "vintage-tv-body-hi": "#c6beb6",
