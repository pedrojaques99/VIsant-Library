      "vintage-surface-3": "color-mix(in oklab, var(--foreground) 4%, var(--background))",
      "vintage-surface-3a": "color-mix(in oklab, var(--foreground) 2%, var(--background))",
      "vintage-surface-4": "var(--background)",
