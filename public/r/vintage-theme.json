      "vintage-tv-console": "color-mix(in oklab, var(--foreground) 18%, var(--background))",
      "vintage-tv-edge": "color-mix(in oklab, var(--background) 55%, black)",
      "vintage-tv-foot-hi": "color-mix(in oklab, var(--foreground) 26%, var(--background))",
      "vintage-tv-foot-lo": "color-mix(in oklab, var(--foreground) 12%, var(--background))",
      "vintage-tv-bezel": "color-mix(in oklab, var(--foreground) 16%, var(--background))",
