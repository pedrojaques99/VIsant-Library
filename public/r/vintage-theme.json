      "vintage-depth-core": "color-mix(in oklab, var(--foreground) 38%, var(--background))",
      "vintage-ring-hi": "color-mix(in oklab, var(--foreground) 90%, var(--background))",
      "vintage-ring-lo": "color-mix(in oklab, var(--foreground) 18%, var(--background))",
      "vintage-face-hi": "color-mix(in oklab, var(--vintage-light) 14%, #f7e2a4)",
      "vintage-face-mid": "color-mix(in oklab, var(--vintage-light) 16%, #ecc86f)",
      "vintage-face-lo": "color-mix(in oklab, var(--vintage-light) 18%, #b98a33)",
