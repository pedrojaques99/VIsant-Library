      "foreground": "#e8e8e8",
      "card": "#1a1a1a",
      "card-foreground": "#e8e8e8",
      "primary": "#ffd700",
      "primary-foreground": "#0f0f0f",
      "secondary": "#2a2a2a",
      "secondary-foreground": "#e8e8e8",
      "muted": "#2a2a2a",
      "muted-foreground": "#888888",
      "accent": "#ff6b35",
      "accent-foreground": "#ffffff",
      "destructive": "#ef4444",
      "destructive-foreground": "#ffffff",
      "border": "#333333",
      "input": "#2a2a2a",
      "ring": "#ffd700"
