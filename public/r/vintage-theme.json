      "vintage-well-shadow": "inset 0 2px 6px rgb(0 0 0 / 0.75), inset 0 0 0 1px rgb(0 0 0 / 0.6), 0 1px 0 rgb(255 255 255 / 0.06)",
      "vintage-engrave": "0 -1px 0 rgb(0 0 0 / 0.55), 0 1px 0 rgb(255 255 255 / 0.06)",
      "vintage-edge": "rgb(0 0 0 / 0.6)",
      "vintage-lip": "rgb(255 255 255 / 0.06)",
