      "vintage-surface-4": "color-mix(in oklab, var(--foreground) 20%, var(--background))",
      "vintage-border": "color-mix(in oklab, var(--foreground) 14%, var(--background))",
      "vintage-text-muted": "color-mix(in oklab, var(--foreground) 55%, var(--background))",
      "vintage-text-dim": "color-mix(in oklab, var(--foreground) 34%, var(--background))",
