  "css": {
    "@supports (color: oklch(from red l c h))": {
      ":root": {
        "--vintage-light": "oklch(from var(--brand, #b8860b) min(l, 0.62) max(c, 0.06) h)",
        "--vintage-label": "oklch(from var(--brand, #b8860b) min(l, 0.38) min(c, 0.1) h)",
        "--vintage-value": "oklch(from var(--brand, #b8860b) min(l, 0.42) c h)"
      },
      ".dark": {
        "--vintage-light": "oklch(from var(--brand, #ffd700) max(l, 0.72) c h)",
        "--vintage-label": "oklch(from var(--brand, #ffd700) max(l, 0.86) min(c, 0.12) h)",
        "--vintage-value": "oklch(from var(--brand, #ffd700) max(l, 0.86) c h)"
      }
    }
  },
  "meta": {
    "uso": {
      "quando": "Montar app ou ferramenta de áudio com o kit vintage: é o tema escuro de painel que as peças vintage-* pressupõem",
      "evite": "Projeto de marca de cliente: use o tema da marca via brand-theme e deixe o kit vintage de fora"
    }
  },
  "categories": [
    "fundacao",
    "tema",
    "css"
  ],
  "type": "registry:theme"
}