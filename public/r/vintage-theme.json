      "vintage-tv-console": "#cdc4bb",
      "vintage-tv-edge": "#4d4946",
      "vintage-tv-foot-hi": "#ccc3bb",
      "vintage-tv-foot-lo": "#9a938d",
      "vintage-tv-bezel": "#bfb7ab",
      "vintage-tv-dial-hi": "#ccc4b7",
      "vintage-tv-dial-lo": "#736d68",
      "vintage-tv-ink": "#4a4540",
      "background": "#f4f2ee",
      "foreground": "#1a1a1a",
      "card": "#fbfaf7",
      "card-foreground": "#1a1a1a",
      "primary": "#1a1a1a",
      "primary-foreground": "#f4f2ee",
      "secondary": "#e6e3dc",
      "secondary-foreground": "#1a1a1a",
      "muted": "#e6e3dc",
      "muted-foreground": "#66635d",
      "accent": "#e6e3dc",
      "accent-foreground": "#1a1a1a",
      "destructive": "#d92d20",
      "destructive-foreground": "#ffffff",
      "border": "#cfccc4",
      "input": "#cfccc4",
      "ring": "#1a1a1a"
