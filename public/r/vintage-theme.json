      "vintage-metal-channel-light": "color-mix(in oklab, var(--foreground) 72%, var(--background))",
      "vintage-metal-channel-dark": "color-mix(in oklab, var(--foreground) 62%, var(--background))",
      "vintage-toggle-track": "color-mix(in oklab, var(--foreground) 20%, var(--background))",
      "vintage-grid": "color-mix(in oklab, var(--foreground) 72%, var(--background))",
      "vintage-cap-hi": "color-mix(in oklab, var(--foreground) 50%, var(--background))",
      "vintage-cap-lo": "color-mix(in oklab, var(--foreground) 14%, var(--background))",
      "vintage-base-hi": "color-mix(in oklab, var(--foreground) 22%, var(--background))",
      "vintage-base-lo": "color-mix(in oklab, var(--background) 55%, black)",
