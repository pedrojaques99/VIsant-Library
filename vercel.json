{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/r/(.*).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/r/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(docs|skills|skills/killer|marca).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ai-catalog+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/mcp/server-card",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/mcp-server-card+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, If-None-Match"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "ETag"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/c/:nome",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/(docs|skills|skills/killer|marca)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=604800, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/((?!r/|og/|assets/|api/|mcp|llms.txt).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/c/:nome",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/r/:nome.md",
      "permanent": false
    },
    {
      "source": "/docs",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/docs.md",
      "permanent": false
    },
    {
      "source": "/skills",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/skills.md",
      "permanent": false
    },
    {
      "source": "/skills/killer",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/skills/killer.md",
      "permanent": false
    },
    {
      "source": "/marca",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/marca.md",
      "permanent": false
    },
    {
      "source": "/kit/marca-viva",
      "destination": "/kit/brand-system",
      "permanent": true
    },
    {
      "source": "/catalogo/aquisicao",
      "destination": "/catalogo/conteudo",
      "permanent": true
    },
    {
      "source": "/catalogo/trabalho",
      "destination": "/catalogo/controles",
      "permanent": true
    },
    {
      "source": "/catalogo/motion",
      "destination": "/catalogo/efeitos",
      "permanent": true
    },
    {
      "source": "/catalogo/marca",
      "destination": "/catalogo/fundacao",
      "permanent": true
    },
    {
      "source": "/catalogo/base",
      "destination": "/catalogo/fundacao",
      "permanent": true
    },
    {
      "source": "/catalogo/cards",
      "destination": "/catalogo/conteudo",
      "permanent": true
    },
    {
      "source": "/catalogo/midia",
      "destination": "/catalogo/conteudo",
      "permanent": true
    },
    {
      "source": "/catalogo/3d",
      "destination": "/catalogo/conteudo",
      "permanent": true
    },
    {
      "source": "/catalogo/texturas",
      "destination": "/catalogo/efeitos",
      "permanent": true
    },
    {
      "source": "/catalogo/vintage",
      "destination": "/catalogo/controles",
      "permanent": true
    },
    {
      "source": "/catalogo/didatica",
      "destination": "/catalogo/anatomia",
      "permanent": true
    },
    {
      "source": "/catalogo/navegacao",
      "destination": "/catalogo/controles",
      "permanent": true
    },
    {
      "source": "/catalogo/dados",
      "destination": "/catalogo/conteudo",
      "permanent": true
    },
    {
      "source": "/catalogo/secoes",
      "destination": "/catalogo/conteudo",
      "permanent": true
    },
    {
      "source": "/catalogo/fundacao",
      "destination": "/docs",
      "permanent": true
    }
  ]
}
