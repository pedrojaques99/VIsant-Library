{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "next-auth/react": ["./src/app/shims/next-auth-react.ts"],
      "next/navigation": ["./src/app/shims/next-navigation.ts"]
    }
  },
  "include": ["src", "registry", "lab"],
  // Uma exclusão, com motivo escrito. Exclusão sem motivo é erro escondido, não
  // configuração. O `data-table` saiu daqui: ele importa Next, e na vitrine esses
  // dois imports apontam pros substitutos de `src/app/shims` (ver `paths` acima).
  "exclude": [
    // Sobra do export do Figma Make (commit "Add files from Figma Make"):
    //    `src/imports/*` e os wrappers soltos em `src/app/components/` que os
    //    importam. Está MORTO — nada no app referencia — e quebrado: `Knob.tsx`
    //    importa um `./svg-xf56mq2vgt` que não existe no disco. Fica excluído em
    //    vez de apagado porque apagar arquivo é decisão do dono do repo.
    //    Para remover de vez:
    //      git rm -r src/imports 'src/app/components/Interactive*' 'src/app/components/Simple*' 'src/app/components/Vintage*'
    //    NÃO apague `src/app/components/ui` nem `figma/`: são os primitivos do
    //    shadcn que `src/components/ui/*` reexporta e o registry usa de verdade.
    "src/imports",
    "src/app/components/Interactive*.tsx",
    "src/app/components/Simple*.tsx",
    "src/app/components/Vintage*.tsx"
  ]
}
